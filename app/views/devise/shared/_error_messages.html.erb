<% if resource.errors.any? %>
  <div style="margin-bottom:var(--space-3);padding:var(--space-3);background:var(--color-accent-2-100);border-radius:var(--radius-md);font-size:13px;color:var(--color-accent-2-800)">
    <ul style="margin:0;padding-left:18px">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
