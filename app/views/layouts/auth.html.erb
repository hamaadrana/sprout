<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Preschool Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Karla:wght@400;500;700&display=swap" rel="stylesheet">

    <%= vite_client_tag %>
    <%= vite_stylesheet_tag "main" %>
  </head>

  <body>
    <main class="min-h-screen flex items-center justify-center px-4 py-12">
      <div class="w-full max-w-sm">
        <div class="text-center mb-8">
          <p class="font-display text-3xl font-semibold text-pine">Preschool Tracker</p>
          <p class="text-ink-soft mt-2 text-sm">What to teach today, and the record to show for it.</p>
        </div>
        <div class="bg-white/80 backdrop-blur rounded-2xl border border-sage-line p-6 shadow-sm">
          <%= yield %>
        </div>
      </div>
    </main>
  </body>
</html>
