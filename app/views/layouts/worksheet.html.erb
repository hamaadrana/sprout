<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Worksheet" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@700&family=Karla:wght@400;700&display=swap" rel="stylesheet">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { background: #e8e4da; }
      body { font-family: "Karla", sans-serif; color: #22301f; }

      .toolbar {
        max-width: 210mm; margin: 0 auto; padding: 16px 8px;
        display: flex; gap: 12px; align-items: center;
      }
      .toolbar a, .toolbar button {
        font: inherit; font-weight: 700; font-size: 14px; cursor: pointer;
        border-radius: 10px; padding: 10px 18px; text-decoration: none;
      }
      .toolbar .print { background: #2b5540; color: #faf6ee; border: none; }
      .toolbar .regen { background: #fff; color: #2b5540; border: 1.5px solid #2b5540; }
      .toolbar .back { color: #5c6657; margin-left: auto; }

      .sheet {
        width: 210mm; min-height: 297mm; margin: 0 auto 24px;
        background: #fff; padding: 14mm 14mm 12mm;
        display: flex; flex-direction: column;
        box-shadow: 0 2px 14px rgba(0,0,0,.12);
      }
      .sheet-header {
        border: 2.5px solid #33291f; border-radius: 6mm;
        padding: 4mm 6mm; margin-bottom: 7mm;
        display: flex; align-items: center; gap: 5mm;
        background: #fff4d6;
      }
      .sheet-header .mascot { font-size: 26pt; line-height: 1; }
      .sheet-header h1 { font-family: "Baloo 2", sans-serif; font-size: 20pt; line-height: 1.1; }
      .sheet-header p { font-size: 10.5pt; color: #675a46; margin-top: 1mm; }
      .sheet-name-row {
        display: flex; gap: 6mm; align-items: baseline; margin-bottom: 6mm;
        font: 700 11pt "Karla", sans-serif; color: #675a46;
      }
      .sheet-name-row .fill {
        flex: 1; border-bottom: 2px solid #33291f;
        font-family: "Baloo 2", sans-serif; font-size: 13pt; color: #33291f;
        padding: 0 2mm;
      }
      .sheet-body { flex: 1; }
      .sheet-footer {
        margin-top: 7mm; padding: 3mm 5mm;
        border: 2px dashed #cbbba1; border-radius: 4mm;
        display: flex; justify-content: space-between; align-items: center;
        font: 700 10pt "Karla", sans-serif; color: #675a46;
      }
      .sheet-footer .stars { display: flex; gap: 2mm; align-items: center; }
      .sheet-footer .stars svg { width: 8mm; height: 8mm; }

      @media print {
        html { background: #fff; }
        .toolbar { display: none; }
        .sheet { width: auto; min-height: auto; margin: 0; padding: 0; box-shadow: none; }
        @page { size: A4 portrait; margin: 14mm 12mm; }
      }

      @media (max-width: 210mm) {
        .sheet { width: 100%; padding: 8mm 6mm; min-height: auto; }
      }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
