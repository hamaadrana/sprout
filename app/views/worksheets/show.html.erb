<% content_for :title, "#{@skill.title} — worksheet" %>

<div class="toolbar">
  <button class="print" onclick="window.print()">Print / Save as PDF</button>
  <%= link_to "Generate new practice",
        plan_item_worksheet_path(@plan_item, variant: @variant + 1), class: "regen" %>
  <%= link_to "← Back to today", root_path, class: "back" %>
</div>

<div class="sheet">
  <header class="sheet-header">
    <h1><%= @skill.title %></h1>
    <p><%= @plan_item.activity.title %></p>
  </header>

  <div class="sheet-body">
    <%= render "worksheets/templates/#{@worksheet[:template]}", worksheet: @worksheet %>
  </div>

  <footer class="sheet-footer">
    <span>Name: <strong><%= @child.name %></strong></span>
    <span><%= @skill.title %></span>
    <span><%= Date.current.strftime("%-d %B %Y") %></span>
  </footer>
</div>
