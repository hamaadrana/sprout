<style>
  .cbs-legend {
    display: flex; gap: 10mm; align-items: center; justify-content: center;
    padding: 4mm; border: 2px solid #33291f; border-radius: 4mm; margin-bottom: 8mm;
    font: 700 13pt "Karla", sans-serif;
  }
  .cbs-legend-item { display: flex; align-items: center; gap: 3mm; }
  .cbs-grid {
    display: grid; grid-template-columns: repeat(5, 1fr);
    gap: 8mm; justify-items: center; margin-top: 6mm;
  }
  .cbs-shape svg { width: 22mm; height: 22mm; }
  .cbs-legend svg { width: 10mm; height: 10mm; }
</style>

<p class="count-hint">
  Read the key, then colour every shape its own colour. Say the colour name each time!
</p>

<div class="cbs-legend">
  <% worksheet[:legend].each do |item| %>
    <span class="cbs-legend-item">
      <%= worksheet_outline_shape(item[:shape]) %>
      = <%= item[:colour] %>
    </span>
  <% end %>
</div>

<div class="cbs-grid">
  <% worksheet[:grid].each do |shape| %>
    <span class="cbs-shape"><%= worksheet_outline_shape(shape) %></span>
  <% end %>
</div>
